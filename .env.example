# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service-role key for invitation lookups and Storage expiry cleanup.
# Never add a NEXT_PUBLIC_ prefix to this value.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (generate one stable pair with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@example.com

# Scheduler authorization for /api/cron/expire-rolls and /api/cron/roll-lifecycle.
CRON_SECRET=

# Afterhours Awards (sample mode is enabled by default)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL_ID=@cf/meta/llama-3.2-11b-vision-instruct
AWARDS_MAX_PHOTOS=10
AWARDS_MOCK_MODE=true
AWARDS_LIVE_PROCESSING_ENABLED=false
AWARDS_PROVIDER_REQUIREMENTS_CONFIRMED=false
